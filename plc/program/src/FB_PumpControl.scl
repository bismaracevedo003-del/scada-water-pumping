FUNCTION_BLOCK "FB_PumpControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Mode : INT;
    Command : BOOL;
    Enable : BOOL;
    Fault : BOOL;
    IsLead : BOOL;
    StartLevel : BOOL;
    StopLevel : BOOL;
    HighPressure : BOOL;
END_VAR
VAR_IN_OUT
    Runtime : DINT;
END_VAR
VAR_OUTPUT
    Run : BOOL;
END_VAR
BEGIN
    IF (NOT Enable) OR Fault OR HighPressure THEN
        Run := FALSE;
    ELSIF Mode = 1 THEN
        IF IsLead AND StartLevel THEN
            Run := TRUE;
        ELSIF (NOT IsLead) AND StartLevel THEN
            Run := TRUE;
        END_IF;
        IF StopLevel THEN
            Run := FALSE;
        END_IF;
    ELSE
        Run := Command;
    END_IF;
    IF Run THEN
        Runtime := Runtime + 1;
    END_IF;
END_FUNCTION_BLOCK
