# SCADA real-mode configuration (placeholders only)
# Copy to .env only on a real deployment and replace every <placeholder>.

MODE=real
REAL_STRICT=true
LOG_LEVEL=INFO

# real telemetry source; simulation default remains DATA_SOURCE=simulator
DATA_SOURCE=mqtt
ALLOW_WRITES=false

MQTT_HOST=broker.example.internal
MQTT_PORT=8883
MQTT_USER=<mqtt-user>
MQTT_PASSWORD=<mqtt-password>
MQTT_TLS=true
MQTT_TLS_CA=/etc/ssl/certs/ca.pem
MQTT_TOPIC_PREFIX=plant/water
MQTT_SNAPSHOT_TOPIC=plant/water/telemetry
MQTT_TIMEOUT_MS=5000

DB_DRIVER=mysql
DB_HOST=db.example.internal
DB_PORT=3306
DB_NAME=scada_water
DB_USER=<db-user>
DB_PASSWORD=<db-password>

PORT=3001
CORS_ORIGIN=https://hmi.example.internal
